(* Natural Numbers *)

type nat = /\ k. &{
  val: \\// mut_nat,
  dup: ?a. <nat, *, a> * \/ nat
}

type mut_nat = +{zero: 1, succ: mut_nat}

proc zero : . |- (n : nat) =
  immut { p =>
    case n (
      val => mut {
        n.zero;
        close n
      }
    | dup =>
        {n1i}, n1 <- zero;
        send n {n1i};
        send n n1;
        continue
    )
  }

proc succ[n0i] : (n0 : <nat, *, n0i>) |- (n : nat) =
  share n0;
  immut n0 { p =>
    case n (
      val => mut {
        own n0;
        n.succ;
        start n0{*};
        n0.val;
        mutate n0;
        n <-> n0
      }
    | dup =>
        start n0{p};
        n0.dup;
        {n1i} <- recv n0;
        n1 <- recv n0;
        finish n0;
        {n2i}, n2 <- succ[n1i] n1;
        send n {n2i};
        send n n2;
        continue n0
    )
  }

proc drop_mut_nat[ni] : (n : <mut_nat, *, ni>) |- (d : 1) =
  case n (
    zero =>
      wait n;
      close d
  | succ =>
      d <- drop_mut_nat[ni] n
  )

proc drop_nat[ni] : (n : <nat, *, ni>) |- (d : 1) =
  start n{*};
  n.val;
  mutate n;
  d <- drop_mut_nat[ni] n

type bool = +{true: 1, false: 1}

proc lte[n1i,n2i] : (n1 : <mut_nat,*,n1i>), (n2 : <mut_nat,*,n2i>) |- (b : bool) =
  case n1 (
    zero =>
      wait n1;
      {di}, d <- drop_mut_nat[n2i] n2;
      wait d;
      b.true;
      close b
  | succ =>
      case n2 (
        zero =>
          wait n2;
          {di}, d <- drop_mut_nat[n1i] n1;
          wait d;
          b.false;
          close b
      | succ => b <- lte[n1i,n2i] n1 n2
      )
  )

proc max[n1i,n2i] : (n1 : <nat,*,n1i>), (n2 : <nat,*,n2i>) |- (res : nat) =
  start n1{*};
  n1.dup;
  {n1di} <- recv n1;
  n1d <- recv n1;
  finish n1;
  start n1d{*};
  n1d.val;
  mutate n1d;

  start n2{*};
  n2.dup;
  {n2di} <- recv n2;
  n2d <- recv n2;
  finish n2;
  start n2d{*};
  n2d.val;
  mutate n2d;

  {bi}, b <- lte[n1di,n2di] n1d n2d;
  case b (
    true =>
      wait b;
      {di}, d <- drop_nat[n1i] n1;
      wait d;
      res <-> n2
  | false =>
      wait b;
      {di}, d <- drop_nat[n2i] n2;
      wait d;
      res <-> n1
  )

type worker = &{
  elect: !n1. <nat, *, n1> -o ?n2. <nat, *, n2> * worker
}

proc worker[idi, wi] : (id : <nat, *, idi>), (child : <worker, *, wi>) |- (w : worker) =
  case w (
    elect =>
      {n1i} <- recv w;
      n1 <- recv w;
      start id{*};
      id.dup;
      {id1i} <- recv id;
      id1 <- recv id;
      finish id;
      {nexti}, next <- max[n1i,id1i] n1 id1;

      child.elect;
      send child {nexti};
      send child next;

      {li} <- recv child;
      leader <- recv child;
      (* record leader *)

      send w {li};
      send w leader;

      w <- worker[idi,wi] id child
  )

proc last_worker[idi] : (id : <nat, *, idi>) |- (w : worker) =
  case w (
    elect =>
      {n1i} <- recv w;
      n1 <- recv w;
      start id{*};
      id.dup;
      {id1i} <- recv id;
      id1 <- recv id;
      finish id;
      {li}, leader <- max[n1i,id1i] n1 id1;
      (* record leader *)

      send w {li};
      send w leader;

      w <- last_worker[idi] id 
  )

proc one : . |- (n : nat) = {n0i}, n0 <- zero; n <- succ[n0i] n0
proc two : . |- (n : nat) = {n0i}, n0 <- one; n <- succ[n0i] n0
proc three : . |- (n : nat) = {n0i}, n0 <- two; n <- succ[n0i] n0

proc main : . |- (res : 1) =
  {n3i}, n3 <- three;
  {w3i}, w3 <- last_worker[n3i] n3;
  {n2i}, n2 <- two;
  {w2i}, w2 <- worker[n2i,w3i] n2 w3;
  {n1i}, n1 <- one;
  {w1i}, w1 <- worker[n1i,w2i] n1 w2;

  {n0i}, n0 <- zero;
  w1.elect;
  send w1 {n0i};
  send w1 n0;

  {li} <- recv w1;
  leader <- recv w1;
  (* all workers know the leader now *)

  abort

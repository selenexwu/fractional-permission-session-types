import bin.frac

type counter = /\k. &{
  inc: \\// counter,
  read: ?a. <bin, *, a> * \/ counter,
  done: \\// ?a. <bin, *, a> * 1
}

proc counter[bi] : (b : <bin, *, bi>) |- (c : counter) =
  immut b { p =>
    case c (
      inc => mut {
        one <- one;
        b1 <- add b one;
        c <- counter b1
      }
    | read =>
        b.dup;
        b1 <- recv b;
        send c b1;
        continue b
    | done => mut {
        send c b;
        close c
      }
    )
  }

import nat.frac

type counter = /\k. &{
  inc: \\// counter,
  read: ?a. <nat, *, a> * \/ counter,
  done: \\// ?a. <nat, *, a> * 1
}

proc counter[ni] : (n : <nat, *, ni>) |- (c : counter) =
  immut n { p =>
    case c (
      inc => mut {
        n1 <- succ n;
        c <- counter n1
      }
    | read =>
        n.dup;
        n1 <- recv n;
        send c n1;
        continue n
    | done => mut {
        send c n;
        close c
      }
    )
  }
